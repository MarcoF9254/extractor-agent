{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoF9254/extractor-agent/schemas/drafts/structural-findings.schema.json",
  "title": "Structural Findings v0.1",
  "description": "Draft machine-checkable conformance result, separate from semantic evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "status",
    "findings"
  ],
  "properties": {
    "contract_version": {
      "const": "structural-findings-v0.1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "error"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "code",
          "artifact_path",
          "json_pointer",
          "message"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^SF-[0-9]{3,}$"
          },
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "artifact_path": {
            "type": "string",
            "minLength": 1
          },
          "json_pointer": {
            "type": "string",
            "pattern": "^(/([^~/]|~0|~1)*)*$"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pass"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        },
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "fail"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        },
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
