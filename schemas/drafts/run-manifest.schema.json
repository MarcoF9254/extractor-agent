{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MarcoF9254/extractor-agent/schemas/drafts/run-manifest.schema.json",
  "title": "Extraction Run Manifest v0.1",
  "description": "Draft immutable membership and provenance record for one evaluation-only extraction run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "run_id",
    "run_purpose",
    "created_at",
    "run_status",
    "source",
    "authority_inputs",
    "invocation",
    "artifacts"
  ],
  "properties": {
    "manifest_version": {
      "const": "run-manifest-v0.1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "run_purpose": {
      "const": "evaluation"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_status": {
      "enum": [
        "completed",
        "failed"
      ],
      "description": "Execution state only; never a knowledge approval state."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "original",
        "selected",
        "sensitive_data_check"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "original": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
              "description": "Path relative to the run directory."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "selected": {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
                  "description": "Path relative to the run directory."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "relation": {
                  "enum": [
                    "original",
                    "redacted_derivative"
                  ]
                }
              },
              "required": [
                "relation"
              ]
            }
          ]
        },
        "sensitive_data_check": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "checked_at",
            "checked_by",
            "notes"
          ],
          "properties": {
            "outcome": {
              "enum": [
                "cleared",
                "redacted_derivative"
              ]
            },
            "checked_at": {
              "type": "string",
              "format": "date-time"
            },
            "checked_by": {
              "type": "string",
              "minLength": 1,
              "description": "Recorded human or authorized reviewer identity/role."
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "sensitive_data_check": {
                "properties": {
                  "outcome": {
                    "const": "cleared"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "selected": {
                "properties": {
                  "relation": {
                    "const": "original"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sensitive_data_check": {
                "properties": {
                  "outcome": {
                    "const": "redacted_derivative"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "selected": {
                "properties": {
                  "relation": {
                    "const": "redacted_derivative"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "authority_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "profile"
      ],
      "properties": {
        "contract": {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
                  "description": "Path relative to the run directory."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "draft",
                    "frozen"
                  ]
                }
              },
              "required": [
                "version",
                "status"
              ]
            }
          ]
        },
        "profile": {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
                  "description": "Path relative to the run directory."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "draft",
                    "frozen"
                  ]
                }
              },
              "required": [
                "name",
                "version",
                "status"
              ]
            }
          ]
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "interface_version",
        "provider",
        "model",
        "prompt",
        "parameters"
      ],
      "properties": {
        "interface_version": {
          "const": "provider-interface-v0.1"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
              "description": "Path relative to the run directory."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "parameters": {
          "type": "object",
          "description": "Provider-neutral invocation parameters used for this run."
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_copy",
        "contract_copy",
        "profile_copy",
        "raw_response",
        "candidate_json",
        "candidate_markdown",
        "structural_findings",
        "evaluation_findings"
      ],
      "properties": {
        "source_copy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
              "description": "Path relative to the run directory."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "contract_copy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
              "description": "Path relative to the run directory."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "profile_copy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
              "description": "Path relative to the run directory."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "raw_response": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
              "description": "Path relative to the run directory."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "candidate_json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
              "description": "Path relative to the run directory."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "candidate_markdown": {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
                  "description": "Path relative to the run directory."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "derived_from": {
                  "const": "candidate/items.json"
                }
              },
              "required": [
                "derived_from"
              ]
            }
          ]
        },
        "structural_findings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
              "description": "Path relative to the run directory."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "evaluation_findings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
              "description": "Path relative to the run directory."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "provider_metadata": {
          "allOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$",
                  "description": "Path relative to the run directory."
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "object",
              "properties": {
                "namespace": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                }
              },
              "required": [
                "namespace"
              ]
            }
          ]
        }
      }
    }
  }
}
